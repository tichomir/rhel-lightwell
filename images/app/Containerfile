# The application layer.
#
# Build context is the repository root:
#   podman build -t quay.io/<ns>/im-train:1.0 -f images/app/Containerfile .
#
# THE CRUCIAL DETAIL: pip install runs HERE, at image build time, inside the
# bootc image. That is what makes remediating a library an OS image rebuild, so
# the application fix travels through the same registry, the same tag promotion
# and the same `bootc upgrade` as an OS fix.
#
# Installing dependencies at runtime would be easier and would destroy the
# entire argument of this demo. Don't.

# Both ARGs are consumed by the FROM below, so they are declared before it -
# that is the one place Containerfile scoping requires it. NS exists so this
# file names no registry of its own: build-and-push.sh passes the namespace it
# is pushing to, and the default merely documents the shape.
ARG NS=quay.io/rhte2023
ARG BASE_TAG=10.1
FROM ${NS}/baseos:${BASE_TAG}

RUN python3 -m venv /opt/app/venv \
    && /opt/app/venv/bin/pip install --no-cache-dir --upgrade pip

COPY requirements.txt /opt/app/requirements.txt

# Lightwell index configuration, MOUNTED and never copied.
#
# pip.conf selects Track A (packages.redhat.com) or Track B (the lab mirror);
# netrc carries the credentials for whichever. Both are supplied by
# build-and-push.sh as build secrets:
#
#   podman build --secret id=netrc,src=images/app/netrc ...
#
# THIS USED TO BE A `COPY` FOLLOWED BY `rm` IN A LATER LAYER, AND THAT LEAKS.
# A COPY writes the file into its own layer; a later rm only hides it from the
# final filesystem. The bytes stay in the layer and come straight back out:
#
#   skopeo copy containers-storage:<image> dir:/tmp/x
#   grep -rl 'password' /tmp/x          # finds the blob
#
# On a bootc image it is worse than it first looks. /root is a symlink to
# /var/roothome, so the credential lands at var/roothome/.netrc - not the path
# you would think to check, and not the path the rm appears to target.
#
# These images are pushed to PUBLIC repositories. With the lab mirror that
# leaks demo/demo; with Track A it would publish a real Red Hat Registry
# Service Account token to the internet.
#
# A --mount=type=secret is never committed to any layer, which is the only
# version of this that is actually safe.
RUN --mount=type=secret,id=pipconf,target=/etc/pip.conf \
    --mount=type=secret,id=netrc,target=/root/.netrc \
    /opt/app/venv/bin/pip install --no-cache-dir -r /opt/app/requirements.txt

COPY app/ /opt/app/app/
COPY sql/ /opt/app/sql/

# SELinux: the venv interpreter and console scripts need an executable type, or
# the unit fails on first boot with a permission error that looks like anything
# except a labelling problem. Test this in rehearsal, not on camera.
RUN semanage fcontext -a -t bin_t "/opt/app/venv/bin(/.*)?" || true \
    && restorecon -R /opt/app || true

COPY images/app/im-train.service /usr/lib/systemd/system/im-train.service
RUN systemctl enable im-train

# Record which dependency set this image was built with, so `podman inspect` and
# `skopeo inspect` can answer "is this the remediated build?" without booting it.
ARG APP_VERSION=dev
ARG DEP_STATE=unknown
LABEL org.opencontainers.image.title="Image Mode Train Service" \
      org.opencontainers.image.version="${APP_VERSION}" \
      net.rhlab.imtrain.tier="app" \
      net.rhlab.imtrain.dependency-state="${DEP_STATE}"
