[Unit]
Description=Image Mode Train Service
Documentation=https://github.com/tichomir/rhel-lightwell
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=IM_TRAIN_TIER=app
Environment=IM_TRAIN_HOST=0.0.0.0
Environment=IM_TRAIN_PORT=8080
# Point at the database host. Edit before building, or override with a drop-in.
Environment=IM_TRAIN_DB_URL=postgresql://imtrain:imtrain@im-train-db.rh-lab.labs:5432/imtrain
WorkingDirectory=/opt/app
ExecStart=/opt/app/venv/bin/python -m app.main
Restart=always
RestartSec=3

# Modest confinement. Note ProtectSystem is not strict-only theatre here: the
# root filesystem is already read-only in image mode, which is worth mentioning
# on camera.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
